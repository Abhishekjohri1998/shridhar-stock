        "backgroundColor": "#a8721a"
      },
      "permissions": ["android.permission.INTERNET"]
    },
    "extra": {
      "//serverUrl": "The stock server this build ships knowing. A device pointed elsewhere from the Server screen keeps its own setting.",
      "serverUrl": "https://stock.3.111.82.220.sslip.io"
    },
    "ios": {}
  }
