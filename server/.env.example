# Copy to server/.env on the server and fill in. Never commit the real one.

# The same Atlas cluster as billing is fine, but MONGO_DB keeps this in its own database.
# Leave MONGO_URI empty to use a local JSON file (server/.data) instead.
MONGO_URI=
MONGO_DB=inventory

# A long random string. Anyone who knows it can make login tokens.
JWT_SECRET=

PORT=4200
CORS_ORIGIN=https://stock.3.111.82.220.sslip.io

# The first admin. Set once, start the server, sign in, then delete these two lines.
SEED_ADMIN_PHONE=
SEED_ADMIN_PIN=
SEED_ADMIN_NAME=Admin
