# Copy to server/.env on the server and fill in. Never commit the real one.

# The same Atlas cluster as billing is fine, but MONGO_DB keeps this in its own database.
# Leave MONGO_URI empty to use a local JSON file (server/.data) instead.
MONGO_URI=
MONGO_DB=inventory

# A long random string. Anyone who knows it can make login tokens.
JWT_SECRET=

PORT=4200
CORS_ORIGIN=https://stock.3.111.82.220.sslip.io

# The first admin. Set once, start the server, sign in, then delete these two lines.
SEED_ADMIN_PHONE=
SEED_ADMIN_PIN=
SEED_ADMIN_NAME=Admin

# The link to billing on the same box: stock reads bills with the shop's PIN.
BILLING_URL=http://127.0.0.1:4000
BILLING_PIN=

# The one-app link: billing's server sends this key on every /api/billing-link/* call (sign-in,
# sessions, whole-shop backup, restore, erase). It must match LINK_KEY in billing's .env, which
# also needs STOCK_URL=http://127.0.0.1:4200. Empty switches those routes off (404).
# Treat it like an admin password: it can open an admin session. `openssl rand -hex 32` makes one.
LINK_KEY=
# The admin whose session the shop PIN opens in the Stock tab. Empty means the oldest admin.
SHOP_ADMIN_PHONE=
